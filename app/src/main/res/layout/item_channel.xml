<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/bgCard"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Channel logo -->
        <ImageView
            android:id="@+id/ivChannelLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_tv"
            android:scaleType="fitCenter"
            android:padding="4dp" />

        <!-- Channel info: name, epg now, time bar, next -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <!-- Channel name -->
            <TextView
                android:id="@+id/tvChannelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="2" />

            <!-- EPG current show title -->
            <TextView
                android:id="@+id/tvEpgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="4dp" />

            <!-- NOW label + time range -->
            <LinearLayout
                android:id="@+id/layoutNowTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW"
                    android:textColor="#2196F3"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textColor="@color/textSecondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvEpgTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#2196F3"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- EPG progress bar -->
            <ProgressBar
                android:id="@+id/pbEpg"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:progressTint="#2196F3"
                android:progressBackgroundTint="#444444"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <!-- Next show -->
            <TextView
                android:id="@+id/tvEpgNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="11sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Play chevron -->
        <ImageView
            android:id="@+id/ivPlay"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/textSecondary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
