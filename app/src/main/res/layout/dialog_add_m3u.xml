<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_red"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add M3U Playlist"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provider Name (optional)"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="My IPTV"
        android:textColor="@color/textPrimary"
        android:textColorHint="#88FFFFFF"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M3U URL *"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://example.com/playlist.m3u"
        android:textColor="@color/textPrimary"
        android:textColorHint="#88FFFFFF"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EPG URL (XMLTV, optional)"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etEpgUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://example.com/epg.xml"
        android:textColor="@color/textPrimary"
        android:textColorHint="#88FFFFFF"
        android:background="@drawable/bg_edittext"
        android:padding="12dp"
        android:inputType="textUri"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:textColor="#AAFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD"
            android:textColor="@color/textPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
