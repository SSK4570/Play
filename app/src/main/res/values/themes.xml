<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base app theme -->
    <style name="Theme.NexPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/textPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSurface">@color/bgCard</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:windowBackground">@color/bgDark</item>
        <item name="android:statusBarColor">@color/bgToolbar</item>
        <item name="android:navigationBarColor">@color/bgDark</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <!-- EditText cursor/handle red -->
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/ripple</item>
    </style>

    <style name="Theme.NexPlayer.Splash" parent="Theme.NexPlayer">
        <item name="android:windowBackground">@color/bgDark</item>
    </style>

    <style name="Theme.NexPlayer.Player" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/playerBg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Dark red dialog theme -->
    <style name="NexDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSurface">@color/bgDialog</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <!-- Button colors in dialog -->
        <item name="buttonBarPositiveButtonStyle">@style/NexDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NexDialogButtonNeg</item>
    </style>

    <style name="NexDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NexDialogButtonNeg" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <!-- Alert dialog override -->
    <style name="NexAlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSurface">@color/bgDialog</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="buttonBarPositiveButtonStyle">@style/NexDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NexDialogButtonNeg</item>
    </style>

    <!-- Toolbar -->
    <style name="NexToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/bgToolbar</item>
        <item name="titleTextColor">@color/textPrimary</item>
    </style>

    <!-- EditText -->
    <style name="NexEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/textHint</item>
    </style>

    <!-- Button -->
    <style name="NexButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!-- Channel text styles -->
    <style name="ChannelName" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ChannelEpg" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
